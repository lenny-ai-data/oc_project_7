# Image de l'interface de chat Puls-Events, cliente de l'API déployée.
# Build : docker build -f Dockerfile.ui -t puls-events-ui .
# Run   : docker run --rm -p 7860:7860 --env-file .env puls-events-ui

# Image python avec uv
FROM ghcr.io/astral-sh/uv:0.12.6-python3.13-trixie-slim

# Bytecode précompilé et copie des paquets
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH" \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_ANALYTICS_ENABLED=False

WORKDIR /app

# Couche des dependances (groupe ui)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --only-group ui --no-cache

# Utilisateur non privilégié, créé avant les copies
RUN useradd --create-home --uid 1000 app

COPY scripts/chat_ui.py scripts/ask_api.py scripts/
COPY assets/ assets/

USER app

# Port du conteneur
EXPOSE 7860

# PORT fourni par l'hébergeur ou 7860 en local.
CMD ["python", "scripts/chat_ui.py"]
